# /srv/tenai/etc/tenai.env  (root:tenai 640). Secrets live in /srv/tenai/secrets/* files, never here.
TENAI_HOME=/srv/tenai/data
TENAI_HOST=0.0.0.0
TENAI_PORT=8470
TENAI_PUBLIC_URL=http://127.0.0.1:8470
TENAI_EMAIL_DOMAIN=example.com
TENAI_ADMINS=dev@example.com
TENAI_MAX_CONCURRENT=4
TENAI_DAILY_TOKENS=2000000
TENAI_MODEL=opus
TENAI_CLAUDE_BIN=/srv/tenai/bin/claude
TENAI_HOOK_CMD=/srv/tenai/bin/bun /srv/tenai/app/packages/providers/src/pretooluse.ts
TENAI_AGENT_USER=tenai-agent
TENAI_INTENT_URL=http://127.0.0.1:8471
TENAI_CLAUDE_TOKEN_FILE=/srv/tenai/secrets/claude_token
TENAI_CLAUDE_STORE=/srv/tenai/secrets/claude_credential.json
TENAI_TEAMS_WEBHOOK_FILE=/srv/tenai/secrets/teams_webhook
TENAI_GITLAB_TOKEN_FILE=/srv/tenai/secrets/gitlab_bot
TENAI_SMTP_HOST=
TENAI_SMTP_PORT=587
TENAI_SMTP_USER=
TENAI_SMTP_PASS_FILE=/srv/tenai/secrets/smtp_pass
TENAI_SMTP_FROM=TenAI <no-reply@example.com>
# Until SMTP is filled in: OTPs are printed to `journalctl -u tenai-server` (admins only can read it).
TENAI_DEV_PRINT_OTP=1
# Repos the agent may work in. Clones live in /srv/tenai/repos (bootstrap does not clone; see README).
TENAI_REPOS=[{"name":"core-api","path":"/srv/tenai/repos/core-api","baseBranch":"env/dev","allowedCommands":["./gradlew compileJava","./gradlew test"]},{"name":"admin-console","path":"/srv/tenai/repos/admin-console","baseBranch":"env/dev","allowedCommands":["npx ng build","npx ng test --watch=false"]}]
