[Unit]
Description=TenAI intent gate sidecar (loopback)
After=network-online.target

[Service]
User=tenai
Group=tenai
WorkingDirectory=/srv/tenai/app/sidecar/intent
ExecStart=/srv/tenai/app/sidecar/intent/.venv/bin/python serve.py model.joblib 8471
Restart=on-failure
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes
MemoryMax=512M

[Install]
WantedBy=multi-user.target
